# Database & berkas (dibuat otomatis oleh `npm run db:reset`)
DATABASE_PATH=./data/kerjain.db
STORAGE_DIR=./storage

# Kunci enkripsi dokumen identitas: 64 karakter hex (32 byte)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=

# Aplikasi
APP_URL=http://localhost:3000
# Aktifkan hanya di belakang proxy tepercaya yang menimpa X-Forwarded-For.
TRUST_PROXY=false
COMMISSION_RATE=0.05
PAYMENT_EXPIRY_HOURS=24

# Payment gateway
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang
# MIDTRANS_SERVER_KEY=   # opsional
